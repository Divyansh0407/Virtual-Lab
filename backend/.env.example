# ==============================================================================
# VirtualLab Backend Environment Configuration (AWS EC2 / Local Port Forward)
# ==============================================================================

# Server Network Binding
# Default to localhost for SSH port forwarding (ssh -L 5000:localhost:5000)
PORT=5000
HOST=127.0.0.1
NODE_ENV=production

# Docker Engine Connection
# On Linux / Ubuntu EC2 instance, Docker listens on the local unix socket
DOCKER_SOCKET=/var/run/docker.sock

# Student Lab Image
LAB_DOCKER_IMAGE=virtuallab-linux:1.0

# Security & CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Capacity & Session Controls (College prototype limits)
MAX_GLOBAL_CONCURRENT_LABS=2
MAX_STUDENT_CONCURRENT_LABS=1
SESSION_DURATION_MINUTES=30
TICKET_TTL_SECONDS=60

# Student Container Hardware Constraints
CONTAINER_MEMORY_LIMIT_MB=128
CONTAINER_CPU_LIMIT=0.25
CONTAINER_PIDS_LIMIT=64

# WebSocket Terminal Rate Limiting
WS_RATE_LIMIT_MESSAGES_PER_SEC=100
